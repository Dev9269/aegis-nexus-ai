# AEGIS NEXUS AI - copy to .env and change every secret before use.
# This file is safe for local development only. For production use HTTPS,
# AEGIS_ENVIRONMENT=production, AEGIS_DEMO_MODE=false, AEGIS_COOKIE_SECURE=true,
# and explicit bootstrap administrator credentials.
AEGIS_ENVIRONMENT=development
AEGIS_DATABASE_URL=sqlite:///./aegis.db
AEGIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
AEGIS_DEMO_MODE=true
AEGIS_DEMO_PASSWORD=ChangeMe-Demo!2026
AEGIS_SESSION_TTL_MINUTES=60
AEGIS_COOKIE_SECURE=false
AEGIS_AUTO_CREATE_TABLES=true
AEGIS_MODEL_ARTIFACT_DIR=ml/artifacts
AEGIS_LOGIN_RATE_LIMIT=8
AEGIS_LOGIN_RATE_WINDOW_SECONDS=60
AEGIS_WS_REVALIDATION_SECONDS=15
AEGIS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
AEGIS_BOOTSTRAP_ADMIN_NAME=Bootstrap Admin

# frontend (Vite). The dev server proxies /api to the backend.
# Demo mode is enabled automatically in development unless set to false.
VITE_API_BASE=/api
VITE_WS_PATH=/api/ws/events
# VITE_DEMO_MODE=false

# Docker / PostgreSQL. Docker was not available in the build environment.
# POSTGRES_DB=aegis
# POSTGRES_USER=aegis
# POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
